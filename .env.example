# Firebase web app config — this is client configuration, not a secret
# credential. Never put a service-account key or Admin SDK JSON here.
VITE_FIREBASE_API_KEY=your-firebase-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-app-id
VITE_FIREBASE_MEASUREMENT_ID=your-measurement-id

# The sole admin account. Firestore/Storage rules also enforce this
# independently — this value only controls the client UI/subscription path.
VITE_ADMIN_EMAIL=admin@example.com

# GitHub Pages project-site path, e.g. /ParkLedger/ . Leave / for custom domains
# or user/organization pages served from the root.
VITE_BASE_PATH=/
