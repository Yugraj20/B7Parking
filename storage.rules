rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    match /receipts/{allPaths=**} {
      // Receipts are private by default (see ParkLedger master brief,
      // Storage rules). A future explicit public flag on the expense could
      // relax read access for a specific receipt; until that exists, only
      // admins can read or write receipt files.
      function isAdmin() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && (
            request.auth.token.admin == true ||
            request.auth.token.email == "yugrajsekhon20@gmail.com" // TODO(remove after custom claim is set)
          );
      }
      allow read: if isAdmin();
      allow write: if isAdmin()
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|application/pdf');
    }
  }
}
